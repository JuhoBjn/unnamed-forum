{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for the unnamed forum",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "nodemon index.js",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "migrate:up": "npx dbmate --url mysql://root:pass@127.0.0.1:3306/dev --wait up",
    "migrate:down": "npx dbmate --url mysql://root:pass@127.0.0.1:3306/dev down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuhoBjn/unnamed-forum.git"
  },
  "keywords": [
    "backend"
  ],
  "author": "Juho Björkman",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JuhoBjn/unnamed-forum/issues"
  },
  "dependencies": {
    "argon2": "^0.40.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-status-codes": "^2.3.0",
    "joi": "^17.12.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^29.7.0",
    "dbmate": "^2.14.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  }
}
